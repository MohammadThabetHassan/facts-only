{
  "name": "facts-only",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Facts Only — stress-tests AI chatbot answers: independent evidence search, claim-by-claim verdicts, and manipulation-pattern source profiling.",
  "license": "MIT",
  "author": "Mohammad Thabet Hassan",
  "homepage": "https://github.com/MohammadThabetHassan/facts-only#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohammadThabetHassan/facts-only.git"
  },
  "bugs": {
    "url": "https://github.com/MohammadThabetHassan/facts-only/issues"
  },
  "keywords": [
    "fact-checking",
    "misinformation",
    "generative-engine-optimization",
    "influence-operations",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "llm",
    "ai-safety",
    "osint"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/e2e.mjs",
    "eval": "node eval/run.mjs",
    "eval:json": "node eval/run.mjs --json",
    "eval:collect": "node eval/collect.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "live": "node scripts/live-check.mjs",
    "build:firefox": "python scripts/build-firefox.py",
    "package": "python scripts/package-extension.py",
    "sbom": "node scripts/sbom.mjs",
    "sbom:check": "node scripts/sbom.mjs --check",
    "release": "python scripts/package-extension.py && python scripts/build-firefox.py && node scripts/sbom.mjs --dist",
    "dev": "python scripts/dev-server.py"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0"
  }
}
